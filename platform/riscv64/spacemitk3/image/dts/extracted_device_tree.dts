			#pwm-cells = <0x03>;
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			status = "disabled";
			reg = <0x00 0xd4022400 0x00 0x10>;
		};

		pwm@c088d500 {
			k1,pwm-disable-fd;
			clock-names = "func", "bus";
			resets = <0xe3 0x04>;
			clocks = <0xe3 0x04 0xe3 0x0e>;
			#pwm-cells = <0x03>;
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			status = "disabled";
			reg = <0x00 0xc088d500 0x00 0x10>;
		};

		spi@d401c000 {
			#address-cells = <0x01>;
			clock-names = "func", "bus";
			resets = <0x81 0x21>;
			interrupts = <0x37 0x04>;
			clocks = <0x81 0x43 0x81 0x46>;
			#size-cells = <0x00>;
			spi-max-frequency = <0x30d4000>;
			interrupt-parent = <0x82>;
			dma-names = "tx", "rx";
			compatible = "spacemit,k3-spi";
			status = "disabled";
			reg = <0x00 0xd401c000 0x00 0x30>;
			dmas = <0x97 0x13 0x97 0x14>;
		};

		i2c@f0614000 {
			power-domains = <0x88 0x05>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			pinctrl-0 = <0x90>;
			clock-names = "func", "bus";
			resets = <0x87 0x02>;
			interrupts = <0x27 0x04>;
			clocks = <0x87 0x05 0x87 0x06>;
			#size-cells = <0x00>;
			interrupt-parent = <0x82>;
			clock-frequency = <0x61a80>;
			compatible = "spacemit,k1-i2c";
			status = "okay";
			reg = <0x00 0xf0614000 0x00 0x38>;

			raspits-panel@45 {
				compatible = "raspberrypi,7inch-touchscreen-panel";
				status = "okay";
				reg = <0x45>;

				port {

					endpoint {
						remote-endpoint = <0x91>;
						phandle = <0xf8>;
					};
				};
			};

			raspits-touch-ft5426@38 {
				compatible = "raspits_ft5426";
				status = "okay";
				reg = <0x38>;
			};
		};

		encoder@d9012000 {
			compatible = "riscv,trace-encoder";
			reg = <0x00 0xd9012000 0x00 0x1000>;
			cpus = <0x0f>;

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0x28>;
						phandle = <0x2a>;
					};
				};
			};
		};

		bridge@d9005000 {
			compatible = "riscv,trace-atbbridge";
			reg = <0x00 0xd9005000 0x00 0x1000>;
			cpus = <0x0c>;

			in-ports {

				port {

					endpoint {
						remote-endpoint = <0x21>;
						phandle = <0x1f>;
					};
				};
			};

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0x20>;
						phandle = <0x4e>;
					};
				};
			};
		};

		phy-pcie@81f00000 {
			spacemit,syscon-apb-spare = <0x1b>;
			spacemit,phy-id = <0x02>;
			#phy-cells = <0x00>;
			num-lanes = <0x01>;
			compatible = "spacemit,k3-pcie-phy";
			status = "disabled";
			reg = <0x00 0x81f00000 0x00 0x1000>;
		};

		cam_ccic@d420a800 {
			clock-names = "csi_func", "ccic_func", "sc2_ahb", "sc2_axi";
			reg-names = "ccic-regs";
			cell-index = <0x01>;
			resets = <0x05 0x00 0x05 0x0a 0x05 0x09 0x05 0x03>;
			interrupts = <0x52 0x04>;
			clocks = <0x05 0x0a 0x05 0x19 0x05 0x1b 0x05 0x0b>;
			spacemit,csiphy = <0xe0>;
			interrupt-parent = <0x82>;
			compatible = "spacemit,ccic";
			status = "okay";
			interrupt-names = "ccic-irq";
			reg = <0x00 0xd420a800 0x00 0x3ff>;
			reset-names = "csi_reset", "ccic_4x_reset", "sc2_hclk_reset", "isp_cibus_reset";
			clock-rates = <0x3b9aca00 0x3b9aca00 0x124f8000 0x186a0000>;
		};

		hdma4@d8808000 {
			dma-coherent;
			resets = <0xd6 0x00 0xd6 0x08>;
			interrupts = <0x0b 0x04>;
			clocks = <0xd6 0x00>;
			interrupt-parent = <0x82>;
			compatible = "spacemit-ai-dmac";
			status = "okay";
			reg = <0x00 0xd8808000 0x00 0x1000>;
			reset-names = "bus", "dma";
		};
	};

	memory@102000000 {
		device_type = "memory";
		reg = <0x01 0x2000000 0x01 0xfe000000>;
	};

	clocks {

		clock-reserved {
			clock-output-names = "reserved_clk";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			compatible = "fixed-clock";
			phandle = <0x7e>;
		};

		clock-32k {
			clock-output-names = "osc_32k";
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			compatible = "fixed-clock";
			phandle = <0x7a>;
		};

		clock-external {
			clock-output-names = "external_clk";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			compatible = "fixed-clock";
			phandle = <0x7f>;
		};

		clock-24m {
			clock-output-names = "vctcxo_24m";
			#clock-cells = <0x00>;
			clock-frequency = <0x16e3600>;
			compatible = "fixed-clock";
			phandle = <0x7d>;
		};

		clock-3m {
			clock-output-names = "vctcxo_3m";
			#clock-cells = <0x00>;
			clock-frequency = <0x2dc6c0>;
			compatible = "fixed-clock";
			phandle = <0x7c>;
		};

		clock-1m {
			clock-output-names = "vctcxo_1m";
			#clock-cells = <0x00>;
			clock-frequency = <0xf4240>;
			compatible = "fixed-clock";
			phandle = <0x7b>;
		};
	};

	rfkill-pcie-wlan {
		radio-type = "wlan";
		pinctrl-names = "default";
		pinctrl-0 = <0x101>;
		shutdown-gpios = <0x8b 0x02 0x09 0x01>;
		label = "rfkill-pcie-wlan";
		compatible = "rfkill-gpio";
	};

	idle-states {

		cluster-nonret {
			entry-latency-us = <0x258>;
			local-timer-stop;
			idle-state-name = "riscv,cluster-nonret";
			exit-latency-us = <0x44c>;
			wakeup-latency-us = <0x5dc>;
			riscv,sbi-suspend-param = <0x91000000>;
			compatible = "riscv,idle-state";
			phandle = <0x03>;
			min-residency-us = <0xa8c>;
		};

		cpu-nonret {
			entry-latency-us = <0xc8>;
			local-timer-stop;
			idle-state-name = "riscv,cpu-nonret";
			exit-latency-us = <0x1f4>;
			riscv,sbi-suspend-param = <0x90000000>;
			compatible = "riscv,idle-state";
			phandle = <0x02>;
			min-residency-us = <0x3b6>;
		};
	};

	riscv-timer {
		riscv,timer-cannot-wake-cpu;
		compatible = "riscv,timer";
	};

