/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "SpacemiT K3 Com260 IFX";
	serial-number = "COM3K3081280080";
	#size-cells = <0x02>;
	compatible = "spacemit,k3-com260-ifx";

	rfkill-m2-bt {
		radio-type = "bluetooth";
		pinctrl-names = "default";
		pinctrl-0 = <0x102>;
		shutdown-gpios = <0x8b 0x01 0x19 0x01>;
		label = "rfkill-m2-bt";
		compatible = "rfkill-gpio";
	};

	hub-reset {
		regulator-max-microvolt = <0x325aa0>;
		regulator-boot-on;
		gpio = <0x8b 0x01 0x15 0x00>;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "hub-reset";
		compatible = "regulator-fixed";
		phandle = <0xc3>;
	};

	apb-pclk {
		clock-output-names = "clk14mhz";
		#clock-cells = <0x00>;
		clock-frequency = <0xd59f80>;
		compatible = "fixed-clock";
		phandle = <0x60>;
	};

	soc {
		#address-cells = <0x02>;
		dma-noncoherent;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		pwm@c088da00 {
			k1,pwm-disable-fd;
			clock-names = "func", "bus";
			resets = <0xe3 0x09>;
			clocks = <0xe3 0x09 0xe3 0x13>;
			#pwm-cells = <0x03>;
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			status = "disabled";
			reg = <0x00 0xc088da00 0x00 0x10>;
		};

		fdcan@c0730000 {
			fsl,clk-source = <0x00>;
			clock-names = "per", "ipg";
			resets = <0xd0 0x02>;
			interrupts = <0xf5 0x04>;
			clocks = <0xd0 0x02 0xd0 0x07>;
			interrupt-parent = <0x82>;
			compatible = "spacemit,k1-flexcan";
			status = "disabled";
			reg = <0x00 0xc0730000 0x00 0x4000>;
		};

		hwspin@cac91c00 {
			compatible = "spacemit,hwspinlock";
			status = "disabled";
			reg = <0x00 0xcac91c00 0x00 0x100>;
		};

		etf@d9043000 {
			clock-names = "apb_pclk";
			clocks = <0x60>;
			compatible = "arm,coresight-tmc", "arm,primecell";
			reg = <0x00 0xd9043000 0x00 0x1000>;

			in-ports {

				port {

					endpoint {
						remote-endpoint = <0x67>;
						phandle = <0x61>;
					};
				};
			};

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0x66>;
						phandle = <0x68>;
					};
				};
			};
		};

		pwm@d401ac00 {
			k1,pwm-disable-fd;
			clock-names = "func", "bus";
			resets = <0x81 0x0e>;
			clocks = <0x81 0x19 0x81 0x2d>;
			#pwm-cells = <0x03>;
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			status = "disabled";
			reg = <0x00 0xd401ac00 0x00 0x10>;
		};

		gpio@d4019000 {
			clock-names = "core", "bus";
			gpio-controller;
			interrupts = <0x3a 0x04>;
			clocks = <0x81 0x14 0x81 0x15>;
			syscon-gpio-regs = <0x83>;
			interrupt-parent = <0x82>;
			compatible = "spacemit,k3-gpio";
			#interrupt-cells = <0x03>;
			syscon-gpio-edge = <0x84>;
			reg = <0x00 0xd4019000 0x00 0x100>;
			phandle = <0x8b>;
			#gpio-cells = <0x03>;
			gpio-ranges = <0x85 0x00 0x00 0x00 0x20 0x85 0x01 0x00 0x20 0x20 0x85 0x02 0x00 0x40 0x20 0x85 0x03 0x00 0x60 0x20>;
			interrupt-controller;
		};

		pinctrl@d401e000 {
			spacemit,apbc = <0x81 0x50>;
			clock-names = "func", "bus";
			spacemit,apmu = <0x05>;
			interrupts = <0x3c 0x04>;
			clocks = <0x81 0x67 0x81 0x68>;
			interrupt-parent = <0x82>;
			compatible = "spacemit,k3-pinctrl";
			spacemit,gpio-edge = <0x84>;
			#interrupt-cells = <0x02>;
			reg = <0x00 0xd401e000 0x00 0x400 0x00 0xd401e800 0x00 0x34>;
			phandle = <0x85>;
			interrupt-controller;

			espi0-2-cfg {

				espi0-1-pins {
					drive-strength = <0x19>;
					pinmux = <0x600004>;
					bias-pull-down;
					power-source = <0x708>;
				};

				espi0-0-pins {
					drive-strength = <0x19>;
					pinmux = <0x5b0004 0x5c0004 0x5d0004 0x5e0004 0x5f0004 0x610004 0x620004>;
					bias-pull-up;
					power-source = <0x708>;
				};
			};

			cam3-0-cfg {

				cam3-0-pins {
					drive-strength = <0x19>;
					bias-disable;
					pinmux = <0x2b0003>;
				};
			};

			pwm13-1-cfg {

				pwm13-0-pins {
					drive-strength = <0x19>;
					pinmux = <0x8a0004>;
					bias-pull-up;
				};
			};

			sspa2-0-cfg {

				sspa2-0-pins {
					drive-strength = <0x19>;
					pinmux = <0x4c0002 0x4d0002 0x4e0002 0x4f0002 0x500002>;
					bias-pull-up;
				};
			};

			ssp3-1-cfg {

				ssp3-1-pins {
					drive-strength = <0x19>;
					pinmux = <0x660001>;
					bias-pull-up;
				};

				ssp3-0-pins {
					drive-strength = <0x19>;
					bias-disable;
					pinmux = <0x630001 0x640001 0x650001>;
				};
			};

			can1-2-cfg {

				can1-0-pins {
					drive-strength = <0x19>;
					pinmux = <0x6d0004 0x6e0004>;
					bias-pull-up;
				};
			};

			ruart3-0-cfg {

